{
  "info": {
    "name": "wpp-sender",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "x-api-key"
      },
      {
        "key": "value",
        "value": "{{apiKey}}"
      },
      {
        "key": "in",
        "value": "header"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "jobId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Status",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/status"
      }
    },
    {
      "name": "Create batch",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('jobId', pm.response.json().id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/batch",
        "header": [
          {
            "key": "content-type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"contacts\": [\n    { \"name\": \"Ana\", \"number\": \"+55 11 99999-0001\" },\n    { \"number\": \"5511999990002\" }\n  ],\n  \"message\": \"Oi {name}!\",\n  \"delayMs\": [15000, 30000]\n}"
        }
      }
    },
    {
      "name": "Get batch",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/batch/{{jobId}}"
      }
    },
    {
      "name": "List batches",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/batch"
      }
    },
    {
      "name": "Cancel batch",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/batch/{{jobId}}"
      }
    }
  ]
}
